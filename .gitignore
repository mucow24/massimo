node_modules/
dist/
.vite/
*.log
.DS_Store

# TypeScript build artifacts
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Vitest coverage output
coverage/

# Playwright artifacts
test-results/
playwright-report/
.playwright/

# Licensed Söhne. The app licence covers shipping the typeface in the app and in
# what the app exports; it does not cover redistributing the font files, so they
# never enter this public repo. They sit on disk locally, and the Pages build
# pulls them from the private mucow24/massimo-fonts repo (see
# .github/workflows/deploy-pages.yml). The two fallback faces are committed on
# purpose — DejaVuSans.ttf (Bitstream Vera) and MassimoSymbols.otf (Apache 2.0,
# see its NOTICE) both carry licences that permit redistribution.
public/fonts/soehne-*.ttf

# Marker left by scripts/stageFonts.mjs when those faces are DejaVu stand-ins
# rather than the real thing. Environment-local, like the faces themselves.
public/fonts/.substitute

# Where the deploy workflow checks that private repo out.
.fonts/

# Unlicensed Helvetica Neue, gone from the tree. Left ignored until its history
# purge lands, so a stray copy on disk can never be committed back by accident.
public/fonts/HelveticaNeue*.ttf
helvetica-neue-*.zip

# Drag-perf harnesses live in .perf/ and ARE tracked (see .perf/README.md) —
# no npm gate or CI job can see them, and the last set was lost by being
# untracked. What stays out: the maps they measure (drawings, not fixtures, and
# megabytes each) and the digests they emit.
.perf/*.massimo.json
.perf/*.txt
.perf/*.local.*

# Exception: one known-slow map, tracked on purpose. Every harness needs a real
# drawing with real crossing density, and this is the one the session-aging
# numbers in .perf/README.md were taken on — without it those numbers cannot be
# reproduced or re-checked after a fix.
!.perf/mta-v23.massimo.json
